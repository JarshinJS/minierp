# Copy to backend/.env for local development. Never commit real values.
# Production values are set on Render (see render.yaml).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# DJANGO_SETTINGS_MODULE=config.settings.dev   # default; Render uses config.settings.prod

# --- Database ---
# Unset: local SQLite (backend/db.sqlite3). Set: Postgres, e.g. a Supabase project.
# Use Supabase's *Session pooler* string (Dashboard -> Connect -> Session pooler):
# the direct db.<ref>.supabase.co host is IPv6-only. Percent-encode special
# characters in the password. Tests always use SQLite and ignore this.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True   # dev default True; set False for a plain local Postgres

# --- Document storage ---
# Unset: trade documents are kept in backend/media/ (never served over HTTP).
# Set: a PRIVATE Supabase Storage bucket through its S3-compatible API. Use a
# separate bucket (ideally a separate project) for development. Required in production.
# STORAGE_BUCKET=trade-documents-dev
# STORAGE_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# STORAGE_REGION=<project-region>
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# DOCUMENT_DOWNLOAD_URL_TTL=300   # seconds a signed download link stays valid

# --- Production only (config.settings.prod) ---
# ALLOWED_HOSTS=api.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com,https://app.example.com

# --- Celery ---
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False   # True = run tasks inline, no worker needed

# --- Email (signup OTPs). Dev prints emails to the console by default. ---
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@example.com

# --- Voice assistant ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# --- Blockchain ---
# BLOCKCHAIN_MOCK_MODE=True
# WEB3_PROVIDER_URL=
# BLOCKCHAIN_WALLET_ADDRESS=
# BLOCKCHAIN_WALLET_PRIVATE_KEY=
