{
  "name": "minierp-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "api:schema": "cd ../backend && python manage.py spectacular --file ../frontend/openapi.yaml",
    "api:types": "openapi-typescript openapi.yaml -o src/lib/api/schema.d.ts",
    "api": "npm run api:schema && npm run api:types",
    "e2e": "playwright test --project=chromium --project=mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:screenshots": "playwright test --project=docs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.65.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
